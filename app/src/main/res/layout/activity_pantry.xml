<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8F2"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MY PANTRY"
        android:textColor="#315C42"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:layout_marginTop="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="What's in your pantry?"
        android:textColor="#20392B"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search ingredients..."
        android:inputType="text"
        android:padding="14dp"
        android:backgroundTint="#315C42"
        android:layout_marginBottom="12dp" />

    <Spinner
        android:id="@+id/categoryFilterSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#315C42"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/addIngredientButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Add Ingredient"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#315C42"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/viewSuggestedRecipesButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Suggested Recipes"
        android:textAllCaps="false"
        android:textColor="#315C42"
        android:backgroundTint="#E8EDE7"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/ingredientList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</LinearLayout>