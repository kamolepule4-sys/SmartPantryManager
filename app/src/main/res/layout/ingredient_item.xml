<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:layout_marginBottom="12dp"
    android:background="#E8EDE7">

    <TextView
        android:id="@+id/ingredientNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chicken"
        android:textColor="#20392B"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/ingredientCategoryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Category: Meat"
        android:textColor="#315C42"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/ingredientQuantityText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quantity: 2 kg"
        android:textColor="#315C42"
        android:textSize="16sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/ingredientExpiryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Expiry: 2026-10-15"
        android:textColor="#555555"
        android:textSize="14sp"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/editIngredientButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#315C42"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/deleteIngredientButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Delete"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#A94442"
            android:layout_marginStart="6dp" />

    </LinearLayout>

</LinearLayout>