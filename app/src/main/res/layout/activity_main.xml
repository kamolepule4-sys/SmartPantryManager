<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8F2">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SMART PANTRY"
            android:textColor="#315C42"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your kitchen,\nunder control."
            android:textColor="#20392B"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use what you have. Waste less food."
            android:textColor="#657469"
            android:textSize="15sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MY PANTRY"
            android:textColor="#20392B"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/pantryEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your pantry is empty.\nAdd your first ingredient to get started."
            android:textColor="#657469"
            android:textSize="15sp"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/addIngredientButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Add Ingredient"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#315C42"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/suggestedRecipesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Find Recipes"
            android:textAllCaps="false"
            android:textColor="#315C42"
            android:backgroundTint="#DCE9DE"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textAllCaps="false"
            android:textColor="#315C42"
            android:backgroundTint="#E8EDE7" />

    </LinearLayout>

</ScrollView>