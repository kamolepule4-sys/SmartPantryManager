<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EDIT INGREDIENT"
            android:textColor="#315C42"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update your ingredient"
            android:textColor="#20392B"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredient name"
            android:textColor="#20392B"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editIngredientNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Chicken"
            android:inputType="text"
            android:padding="14dp"
            android:backgroundTint="#315C42"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quantity"
            android:textColor="#20392B"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editQuantityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 2"
            android:inputType="numberDecimal"
            android:padding="14dp"
            android:backgroundTint="#315C42"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unit"
            android:textColor="#20392B"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editUnitInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. kg, g, items"
            android:inputType="text"
            android:padding="14dp"
            android:backgroundTint="#315C42"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textColor="#20392B"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/editCategorySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#315C42"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expiry date (optional)"
            android:textColor="#20392B"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editExpiryDateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 2026-10-15"
            android:inputType="date"
            android:padding="14dp"
            android:backgroundTint="#315C42"
            android:layout_marginBottom="28dp" />

        <Button
            android:id="@+id/updateIngredientButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Ingredient"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#315C42"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/cancelEditButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#315C42"
            android:backgroundTint="#E8EDE7" />

    </LinearLayout>

</ScrollView>